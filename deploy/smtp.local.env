# Local development only. Do not use this key in another environment.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURITY=plaintext
SMTP_ALLOW_PLAINTEXT=true
SMTP_TLS_BACKEND=rustls
SMTP_FROM="LinkKeys local development <linkkeys@example.test>"

# Use the HTTPS origin where the local LinkKeys UI is available.
PUBLIC_ORIGIN=https://localhost:8443

# This public value is safe only for disposable local development data.
OUTBOX_ENCRYPTION_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f

SMTP_TIMEOUT_SECONDS=5
OUTBOX_MAX_ATTEMPTS=3
OUTBOX_LEASE_SECONDS=30
OUTBOX_POLL_MILLISECONDS=250
