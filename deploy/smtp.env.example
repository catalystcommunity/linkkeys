# SMTP stays disabled until SMTP_HOST is set.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_TLS_BACKEND=rustls
SMTP_FROM="LinkKeys <linkkeys@example.com>"
SMTP_USERNAME=linkkeys
SMTP_PASSWORD=replace-with-a-secret

# This value must be the public HTTPS origin without a path.
PUBLIC_ORIGIN=https://id.example.com

# Generate 32 random bytes. Use hexadecimal or unpadded base64url.
OUTBOX_ENCRYPTION_KEY=replace-with-a-secret

# Optional worker settings.
SMTP_TIMEOUT_SECONDS=30
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_LEASE_SECONDS=60
OUTBOX_POLL_MILLISECONDS=1000
